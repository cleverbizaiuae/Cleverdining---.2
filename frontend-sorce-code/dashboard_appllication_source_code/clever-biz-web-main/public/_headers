# Static Vite assets are fingerprinted. Cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Netlify-CDN-Cache-Control: public, max-age=31536000, immutable, durable

# Image/icon assets copied from public.
/*.png
  Cache-Control: public, max-age=31536000, immutable
  Netlify-CDN-Cache-Control: public, max-age=31536000, durable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  Netlify-CDN-Cache-Control: public, max-age=31536000, durable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Netlify-CDN-Cache-Control: public, max-age=31536000, durable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Netlify-CDN-Cache-Control: public, max-age=31536000, durable

# SPA shell and authenticated dashboard routes must never serve an old deploy.
/*.html
  Cache-Control: no-store, max-age=0
  Netlify-CDN-Cache-Control: no-store, max-age=0
/
  Cache-Control: no-store, max-age=0
  Netlify-CDN-Cache-Control: no-store, max-age=0
/login
  Cache-Control: no-store, max-age=0
  Netlify-CDN-Cache-Control: no-store, max-age=0
/restaurant
  Cache-Control: no-store, max-age=0
  Netlify-CDN-Cache-Control: no-store, max-age=0
/restaurant/*
  Cache-Control: no-store, max-age=0
  Netlify-CDN-Cache-Control: no-store, max-age=0
/staff
  Cache-Control: no-store, max-age=0
  Netlify-CDN-Cache-Control: no-store, max-age=0
/staff/*
  Cache-Control: no-store, max-age=0
  Netlify-CDN-Cache-Control: no-store, max-age=0
/chef
  Cache-Control: no-store, max-age=0
  Netlify-CDN-Cache-Control: no-store, max-age=0
/chef/*
  Cache-Control: no-store, max-age=0
  Netlify-CDN-Cache-Control: no-store, max-age=0
/superadmin
  Cache-Control: no-store, max-age=0
  Netlify-CDN-Cache-Control: no-store, max-age=0
/superadmin/*
  Cache-Control: no-store, max-age=0
  Netlify-CDN-Cache-Control: no-store, max-age=0
/multilocation
  Cache-Control: no-store, max-age=0
  Netlify-CDN-Cache-Control: no-store, max-age=0
/multilocation/*
  Cache-Control: no-store, max-age=0
  Netlify-CDN-Cache-Control: no-store, max-age=0

# App update files must revalidate so PWA updates are safe.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Netlify-CDN-Cache-Control: no-store, max-age=0
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Netlify-CDN-Cache-Control: no-store, max-age=0
