  Netlify-CDN-Cache-Control: public, max-age=300, stale-while-revalidate=3600, durable
/chef/*
  Cache-Control: public, max-age=0, must-revalidate
  Netlify-CDN-Cache-Control: public, max-age=300, stale-while-revalidate=3600, durable
/superadmin
  Cache-Control: public, max-age=0, must-revalidate
  Netlify-CDN-Cache-Control: public, max-age=300, stale-while-revalidate=3600, durable
